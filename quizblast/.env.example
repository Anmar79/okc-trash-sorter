# Copy this file to .env and change the values.

# Password for the admin pages (create/edit quizzes, host games).
ADMIN_PASSWORD=change-me

# Port this app listens on. Your web server forwards traffic to it.
PORT=3000

# Serve the app under a sub-path, e.g. https://your-server/quizblast/
BASE_PATH=/quizblast

# The address players use to join. Shown on the projector and in the QR code.
PUBLIC_URL=https://svpueshostv01.ci.okc/quizblast

# Where quizzes, images and reports are saved (default: ./data)
# DATA_DIR=D:\quizblast-data
