<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS: forward https://<server>/quizblast/* to the QuizBlast app on port 3000.

  1. Install the IIS "URL Rewrite" and "Application Request Routing (ARR)" modules.
  2. IIS Manager > server node > Application Request Routing Cache >
     Server Proxy Settings > tick "Enable proxy" > Apply.
  3. (Recommended) Server Manager > Add Roles and Features > Web Server >
     Application Development > "WebSocket Protocol". Without it the game still
     works, it just falls back to slightly slower polling.
  4. Create a folder named "quizblast" in the website's root folder (next to
     tools_hub) and save this file inside it as "web.config".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="QuizBlast" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/quizblast/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
